{
  "version": 2,
  "rewrites": [
    { "source": "/api/find", "destination": "/api/find" },
    { "source": "/api/search", "destination": "/api/search" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
